#!/usr/bin/env bash
# Default Pi call: OpenRouter free Nemotron + high thinking + read/write/exec tools.
# Usage: pi-run <cwd> "<prompt>" [--session <name>] [--timeout sec] [--verbose]
here="$(cd "$(dirname "$0")" && pwd)"
export PATH=$HOME/.local/bin:$PATH
dir="$1"; shift; prompt="$1"; shift
exec "$here/pi-call.mjs" "$dir" openrouter/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free "$prompt" --allow-write --thinking high "$@"
